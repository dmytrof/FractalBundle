{
    "name": "dmytrof/fractal-bundle",
    "type": "symfony-bundle",
    "description": "Symfony FractalBundle",
    "keywords": ["Fractal"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dmytro Feshchenko",
            "email": "dmytro.feshchenko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "doctrine/collections": "^2.2 || ^3.0",
        "league/fractal": "^0.20.1 || ^0.21",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofsymfony/rest-bundle": "^3.8",
        "phpunit/phpunit": "^11.5",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0"
    },
    "conflict": {
        "friendsofsymfony/rest-bundle": "<3.0"
    },
    "autoload": {
        "psr-4": {
            "Dmytrof\\FractalBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmytrof\\FractalBundle\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "friendsofsymfony/rest-bundle": "Adds support for using Fractal with FOSRestBundle"
    },
    "scripts": {
        "test": "phpunit"
    }
}
